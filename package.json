{
  "name": "darkforest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "lab": "tsx packages/evals/src/cli.ts",
    "eval": "tsx packages/evals/src/run.ts",
    "routing:smoke": "tsx packages/evals/src/routing-smoke.ts",
    "cf:verify": "tsx packages/evals/src/cf-verify.ts",
    "suite1:ab": "tsx packages/evals/src/suite1-ab.ts",
    "event:diag": "tsx packages/evals/src/event-diag.ts",
    "pacing": "tsx packages/evals/src/pacing-experiment.ts",
    "fact:probe": "tsx packages/evals/src/fact-turn-probe.ts",
    "selectivity": "tsx packages/evals/src/selectivity-ab.ts",
    "ladder": "tsx packages/evals/src/context-ladder.ts",
    "agency": "tsx packages/evals/src/agency-experiment.ts",
    "gauntlet": "tsx packages/evals/src/gauntlet.ts",
    "extract:probe": "tsx packages/evals/src/extraction-probe.ts",
    "suite1": "tsx packages/evals/src/suite1.ts",
    "gate": "tsx packages/evals/src/gate.ts",
    "embed:compare": "tsx packages/evals/src/embed-compare.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:snapshot": "tsx scripts/snapshot.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
