# Dark Forest — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Production secrets live only in the Worker secret store (docs/12-security.md § 2).
#
# Which providers are safe for REAL USER CONTENT is not a matter of preference —
# see docs/benchmarks/2026-09-03-provider-landscape.md and ADR-009.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
DF_ENV=local                      # local | staging | production
LOG_LEVEL=info

# When true, no real provider is called. A fully working product must be
# demonstrable in this mode — see docs/08-ai-router.md § 10.
MOCK_AI=true


# ─── PRIVACY-CLEAN providers — usable for real user content ───────────────────
# Groq: contractually does not train on inputs/outputs, free tier included.
# Enable Zero Data Retention in the console before any real user traffic.
GROQ_API_KEY=

# Cloudflare Workers AI — embeddings only (bge-base-en-v1.5, 768-dim).
# Does not train on customer content. 10,000 neurons/day shared budget.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# OpenRouter — deep tier / long context (Nemotron Ultra & Lightning).
# 50 req/day until a one-time $10 credit raises it to 1,000 (ADR-011).
# Verify the training opt-out is enabled in account settings.
OPENROUTER_API_KEY=


# ─── DEVELOPMENT-ONLY providers ───────────────────────────────────────────────
# ⚠ BOTH of these train on submitted content and explicitly warn against
# personal data. They are DISABLED IN PRODUCTION by config, not by convention.
# Use only with synthetic or founder-authored test data.
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=


# ─── Database ─────────────────────────────────────────────────────────────────
# Local: Docker Postgres + pgvector (does not consume a Supabase project slot)
DATABASE_URL=postgresql://darkforest:darkforest@localhost:5433/darkforest

# Supabase (staging / production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Break-glass credential. Bypasses ALL row-level security. Server-side only,
# and only in the ≤5 annotated locations that genuinely need it.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Channels (Phase 10+) ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=


# ─── Application secrets ──────────────────────────────────────────────────────
SESSION_SIGNING_KEY=
# Never rotate — rotation orphans every linked WhatsApp identity.
PHONE_HASH_SALT=
